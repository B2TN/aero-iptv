<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- L'application vise les TV mais ne les exige pas : "required" à true
         l'exclurait des boîtiers qui déclarent mal leurs fonctionnalités. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"/>
    <!-- Sans cette ligne, Google Play et l'Amazon Appstore écartent les TV. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>

    <!-- screenOrientation implique cette exigence : elle est levée pour ne pas
         écarter un boîtier qui ne la déclare pas. -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false"/>

    <!-- allowBackup : une sauvegarde restaurerait des données chiffrées avec une
         clé du Keystore qui n'existe pas sur le nouvel appareil.
         usesCleartextTraffic : de nombreux flux IPTV sont servis en HTTP. -->
    <application
        android:label="Aero IPTV"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Fait apparaître l'application sur l'écran d'accueil des TV. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

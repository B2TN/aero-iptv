import 'catalog.drift';

-- Données de l'utilisateur. Elles reposent sur `content_key` et non sur les
-- identifiants de lignes, qui changent à chaque synchronisation.

CREATE TABLE watch_progress (
  source_id INTEGER NOT NULL REFERENCES sources (id) ON DELETE CASCADE,
  content_key TEXT NOT NULL,
  kind INTEGER NOT NULL,
  title TEXT NOT NULL,
  poster_url TEXT,
  position_ms INTEGER NOT NULL,
  duration_ms INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  stream_url TEXT,
  xtream_stream_id INTEGER,
  container_ext TEXT,
  user_agent TEXT,
  referrer TEXT,
  -- Identité commune aux versions (`m:titre` ou `e:série:saison:épisode`),
  -- série, et place de l'épisode : « Continuer à regarder » les regroupe.
  work_key TEXT,
  series_key TEXT,
  season INTEGER,
  episode INTEGER,
  -- Vu jusqu'au bout, ou retiré de « Continuer à regarder » par l'utilisateur.
  finished BOOLEAN NOT NULL DEFAULT FALSE,
  hidden BOOLEAN NOT NULL DEFAULT FALSE,
  PRIMARY KEY (source_id, content_key)
) WITHOUT ROWID AS WatchProgressRow;

CREATE INDEX watch_progress_recent ON watch_progress (source_id, updated_at DESC);

-- Favoris. `favorite_key` regroupe toutes les versions d'un contenu et survit
-- aux synchronisations : clé de titre d'un film, clé de regroupement d'une
-- série ou d'une chaîne.
CREATE TABLE favorites (
  source_id INTEGER NOT NULL REFERENCES sources (id) ON DELETE CASCADE,
  kind INTEGER NOT NULL,
  favorite_key TEXT NOT NULL,
  title TEXT NOT NULL,
  poster_url TEXT,
  added_at INTEGER NOT NULL,
  PRIMARY KEY (source_id, kind, favorite_key)
) WITHOUT ROWID AS FavoriteRow;

CREATE TABLE app_settings (
  setting_key TEXT NOT NULL PRIMARY KEY,
  setting_value TEXT NOT NULL
) AS AppSettingRow;

recentProgress:
  SELECT * FROM watch_progress
  WHERE source_id = :source_id AND NOT finished AND NOT hidden
  ORDER BY updated_at DESC
  LIMIT :limit;

progressHistory:
  SELECT * FROM watch_progress
  WHERE source_id = :source_id AND NOT hidden
  ORDER BY updated_at DESC
  LIMIT :limit;

progressOfKey:
  SELECT * FROM watch_progress
  WHERE source_id = :source_id AND (work_key = :key OR series_key = :key)
  ORDER BY updated_at DESC;

hideProgress:
  UPDATE watch_progress SET hidden = TRUE
  WHERE source_id = :source_id
    AND (series_key = :group_key OR work_key = :group_key
         OR content_key = :group_key);

deleteProgress:
  DELETE FROM watch_progress
  WHERE source_id = :source_id AND content_key = :content_key;

import 'catalog.drift';

-- Données de l'utilisateur. Elles reposent sur `content_key` et non sur les
-- identifiants de lignes, qui changent à chaque synchronisation.

CREATE TABLE watch_progress (
  source_id INTEGER NOT NULL REFERENCES sources (id) ON DELETE CASCADE,
  content_key TEXT NOT NULL,
  kind INTEGER NOT NULL,
  title TEXT NOT NULL,
  poster_url TEXT,
  position_ms INTEGER NOT NULL,
  duration_ms INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  stream_url TEXT,
  xtream_stream_id INTEGER,
  container_ext TEXT,
  user_agent TEXT,
  referrer TEXT,
  PRIMARY KEY (source_id, content_key)
) WITHOUT ROWID AS WatchProgressRow;

CREATE INDEX watch_progress_recent ON watch_progress (source_id, updated_at DESC);

CREATE TABLE app_settings (
  setting_key TEXT NOT NULL PRIMARY KEY,
  setting_value TEXT NOT NULL
) AS AppSettingRow;

recentProgress:
  SELECT * FROM watch_progress
  WHERE source_id = :source_id
  ORDER BY updated_at DESC
  LIMIT :limit;

deleteProgress:
  DELETE FROM watch_progress
  WHERE source_id = :source_id AND content_key = :content_key;
